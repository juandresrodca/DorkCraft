# EditorConfig — https://editorconfig.org
#
# DorkCraft is two halves with two conventions: a FastAPI backend on four-space
# Python and an Astro frontend on two-space markup. CONTRIBUTING.md says so in
# prose; this file is the machine-readable half, so a contributor's editor gets
# it right before review has to mention it.
#
# Most editors honour this natively. VS Code needs the EditorConfig extension —
# frontend/.vscode/extensions.json recommends it.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Backend — PEP 8, matching the four-space indentation CONTRIBUTING.md requires.
[*.py]
indent_size = 4
max_line_length = 100

[backend/requirements.txt]
indent_size = 4

# Frontend — Astro, TypeScript and the config files beside them.
[*.{astro,ts,mjs,js,json,css,svg}]
indent_size = 2

# Data and CI definitions. YAML cannot be indented with tabs at all, and the
# issue forms under .github/ are hand-edited often enough to be worth pinning.
[*.{yml,yaml}]
indent_size = 2

# Markdown keeps trailing whitespace: two spaces at end of line is a hard break,
# and stripping them silently reflows the prose in README.md and docs/.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Generated by npm — never hand-edited, so do not fight the generator's format.
[frontend/package-lock.json]
indent_size = 2
insert_final_newline = false

# Verbatim third-party text. Left exactly as received.
[LICENSE]
indent_size = 4
trim_trailing_whitespace = false
