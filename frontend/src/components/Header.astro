---
/**
 * Header component
 * Displays the DorkCraft logo, subtitle, and a GitHub link.
 */
---
<header class="dc-header">
  <div class="dc-header__inner">
    <a href="/" class="dc-logo" aria-label="DorkCraft home">
      <!-- SVG shield + magnifier mark -->
      <svg class="dc-logo__icon" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <rect width="28" height="28" rx="8" fill="url(#logoGrad)"/>
        <path d="M14 5L6 8.5V14C6 18.42 9.5 22.6 14 24C18.5 22.6 22 18.42 22 14V8.5L14 5Z"
              fill="none" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
        <circle cx="13" cy="14" r="3" stroke="white" stroke-width="1.5"/>
        <line x1="15.5" y1="16.5" x2="18" y2="19" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
        <defs>
          <linearGradient id="logoGrad" x1="0" y1="0" x2="28" y2="28" gradientUnits="userSpaceOnUse">
            <stop stop-color="#6366f1"/>
            <stop offset="1" stop-color="#8b5cf6"/>
          </linearGradient>
        </defs>
      </svg>
      <span class="dc-logo__text">DorkCraft</span>
    </a>

    <p class="dc-header__subtitle">
      Generate advanced Google search operators from plain English
    </p>

    <a
      href="https://github.com/juandresrodca/DorkCraft"
      target="_blank"
      rel="noopener noreferrer"
      class="dc-header__gh-link"
      aria-label="View on GitHub"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.477 2 2 6.484 2 12.021c0 4.428 2.865 8.185 6.839 9.504.5.092.682-.217.682-.482
                 0-.237-.009-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466
                 -.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832
                 .092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688
                 -.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0
                 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028
                 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012
                 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.021C22 6.484 17.522 2 12 2Z"/>
      </svg>
      <span>GitHub</span>
    </a>
  </div>
</header>
