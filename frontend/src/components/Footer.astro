---
/**
 * Footer component
 * Displays the safety disclaimer and attribution.
 */
---
<footer class="dc-footer">
  <div class="dc-footer__inner">
    <span class="dc-footer__shield" aria-hidden="true">🛡️</span>
    <p class="dc-footer__disclaimer">
      Use responsibly and only for legal OSINT and research purposes.
      DorkCraft does not store queries. Always respect privacy, terms of service, and applicable laws.
    </p>
    <p class="dc-footer__copy">
      DorkCraft &copy; {new Date().getFullYear()} — Open Source
    </p>
  </div>
</footer>
